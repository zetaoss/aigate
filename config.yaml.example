server:
  port: 8080
  logLevel: info
  validateModelsOnStartup: true

fallback:
  rounds: 2
  perAttemptTimeout: 30s

models:
  # fallback priority: first model is tried first
  # format: {provider}/{model}
  - gemini/gemini-2.5-flash
  - ollama/gemma4:31b

providers:
  gemini:
    apiKey: YOUR_GEMINI_API_KEY
  ollama:
    apiKey: YOUR_OLLAMA_API_KEY
